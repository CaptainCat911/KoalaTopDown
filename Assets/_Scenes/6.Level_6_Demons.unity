    - target: {fileID: 585231619816024824, guid: fd2a44bda32e38a4780066b9367b5be5, type: 3}
      propertyPath: m_text
      value: "\u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C
        \u0431\u043E\u043C\u0431\u044B, \u0434\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430
        \u043A\u0443\u043F\u0438\u0442\u0435 \u0431\u043E\u043C\u0431\u044B \u0438
        \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435
        \u043A \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0443. \u041D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435
        \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
        \u0442\u0438\u043F \u0431\u043E\u043C\u0431\u044B, \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
        \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u0438 \u0446\u0435\u043D\u0430."
