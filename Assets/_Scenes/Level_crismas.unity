  - name: '6. '
    sentences:
    - "\u0415\u0449\u0435 \u0440\u0430\u0437 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E
      \u0437\u0430 \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435, \u043E\u0445\u043E\u0442\u043D\u0438\u043A! "
    - "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u044F \u0440\u0430\u043D\u0435\u043D
      \u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u043B\u0430\u0431,
      \u0447\u0442\u043E\u0431\u044B \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F
      \u0441\u043E \u0437\u043B\u044B\u043C \u043C\u0430\u0433\u043E\u043C. \u041F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u0442\u0435\u0431\u0435 \u043E\u0434\u043E\u043B\u0435\u0442\u044C \u0435\u0433\u043E
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443"
    - "\u0412\u043E\u0442 \u0434\u0435\u0440\u0436\u0438 \u044D\u0442\u043E\u0442
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u043B\u044E\u0447,
      \u043E\u043D \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0434\u0432\u0435\u0440\u0438
      \u0432 \u043B\u043E\u0433\u043E\u0432\u043E \u043C\u0430\u0433\u0430"
