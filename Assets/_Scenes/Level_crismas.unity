    - target: {fileID: 6922085211348464282, guid: b4d4f6f0b9b1baa4cb9ed9e1dbbd8fd7, type: 3}
      propertyPath: m_text
      value: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
        \u0432 \u0445\u0430\u0440\u0434\u043A\u043E\u0440 \u0440\u0435\u0436\u0438\u043C.
        \u0421\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F
        \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0430.
        \u0415\u0441\u043B\u0438 \u043D\u0430\u0431\u0435\u0440\u0435\u0442\u0435
        10 \u043C\u0435\u0442\u043E\u043A \u043F\u043E\u0437\u043E\u0440\u0430 \u0442\u043E
        \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0438 \u043D\u0430\u0447\u043D\u0451\u0442\u0435
        \u0441\u043D\u0430\u0447\u0430\u043B\u0430. \r\n\u0423\u0434\u0430\u0447\u0438!\r\n"
      objectReference: {fileID: 0}
