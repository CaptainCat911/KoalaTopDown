      propertyPath: m_text
      value: "\u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C
        \u0431\u043E\u043C\u0431\u044B, \u0434\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430
        \u043A\u0443\u043F\u0438\u0442\u0435 \u0431\u043E\u043C\u0431\u044B \u0438
        \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435
